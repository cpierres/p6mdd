<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.mdd</groupId>
    <artifactId>p6mdd-parent</artifactId>
    <version>1.0.2</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>front</artifactId>
  <name>P6MDD Frontend</name>
  <description>Module frontend de l'application P6MDD</description>

  <build>
    <plugins>
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>${frontend-maven-plugin.version}</version>
        <configuration>
          <nodeVersion>${node.version}</nodeVersion>
          <npmVersion>${npm.version}</npmVersion>
          <workingDirectory>.</workingDirectory>
        </configuration>
        <executions>
          <!-- Installation de Node et npm -->
          <execution>
            <id>install-node-and-npm</id>
            <goals>
              <goal>install-node-and-npm</goal>
            </goals>
          </execution>

          <!-- Installation des dépendances npm -->
          <execution>
            <id>npm-install</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>install</arguments>
            </configuration>
          </execution>

          <!-- Mise à jour de la version dans package.json -->
          <execution>
            <id>update-version</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>version --no-git-tag-version --allow-same-version ${project.version}</arguments>
            </configuration>
          </execution>

          <!-- Build du projet Angular -->
          <execution>
            <id>npm-build</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>run build</arguments>
            </configuration>
          </execution>

          <!-- Tests unitaires -->
          <execution>
            <id>npm-test</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <phase>test</phase>
            <configuration>
              <arguments>test -- --watch=false --browsers=ChromeHeadless</arguments>
              <skip>${skipTests}</skip>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>docker-image</id>
      <activation>
        <property>
          <name>docker.image.build</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <version>0.46.0</version>
            <configuration>
              <images>
                <image>
                  <name>cpierres/ocr-p6-mdd-front-${spring.profiles.active}:${project.version}</name>
                  <build>
                    <contextDir>${project.basedir}</contextDir>
                    <dockerFile>Dockerfile</dockerFile>
                    <args>
                      <ENV_NAME>${spring.profiles.active}</ENV_NAME>
                      <VERSION>${project.version}</VERSION>
                    </args>
                  </build>
                </image>
              </images>
            </configuration>
            <executions>
              <execution>
                <id>docker-build</id>
                <phase>package</phase>
                <goals>
                  <goal>build</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
